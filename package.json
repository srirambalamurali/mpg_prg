{
  "name": "auto-mpg-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Professional monorepo for the Auto MPG AI prediction application.",
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix apps/frontend\" \"uvicorn apps.backend.app.main:app --reload --host 127.0.0.1 --port 8000\"",
    "frontend": "npm run dev --prefix apps/frontend",
    "backend": "uvicorn apps.backend.app.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "turbo run build",
    "start": "uvicorn apps.backend.app.main:app --host 0.0.0.0 --port 8000"
  },
  "devDependencies": {
    "@babel/helper-validator-identifier": "^7.29.7",
    "concurrently": "^9.0.1",
    "turbo": "^2.0.12"
  }
}
