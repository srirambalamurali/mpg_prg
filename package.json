{
  "name": "auto-mpg-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Professional monorepo for the Auto MPG AI prediction application.",
  "scripts": {
    "dev": "concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "pnpm --dir apps/frontend dev",
    "dev:backend": "python -m uvicorn apps.backend.app.main:app --app-dir . --reload --host 127.0.0.1 --port 8000",
    "frontend": "pnpm --dir apps/frontend dev",
    "backend": "python -m uvicorn apps.backend.app.main:app --app-dir . --reload --host 127.0.0.1 --port 8000",
    "build": "pnpm --dir apps/frontend build",
    "start": "python -m uvicorn apps.backend.app.main:app --app-dir . --host 0.0.0.0 --port 8000"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "turbo": "^2.0.12"
  },
  "packageManager": "pnpm@9.15.4"
}
