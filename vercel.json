{
  "version": 2,
  "builds": [
    {
      "src": "apps/backend/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "apps/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "functions": {
    "apps/backend/index.py": {
      "includeFiles": "ml/models/final_pipeline.pkl"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "apps/backend/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
